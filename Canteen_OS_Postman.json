{
  "info": {
    "_postman_id": "canteen-os-full-api",
    "name": "Canteen OS - Complete API Suite",
    "description": "Full API test collection for Canteen OS Food Court Management System.\n\nWorkflow: Login first → token auto-saved → all other requests authenticated.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{auth_token}}", "type": "string" }]
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:5000", "type": "string" },
    { "key": "auth_token", "value": "", "type": "string" }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.response.json() && pm.response.json().token) {",
          "    pm.collectionVariables.set('auth_token', pm.response.json().token);",
          "    console.log('Token saved automatically.');",
          "}"
        ]
      }
    }
  ],
